rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBeat(data) {
      return data.keys().hasAll(['id', 'title', 'bpm', 'genre', 'artwork']) &&
             data.id is string && data.title is string && data.bpm is number &&
             data.genre is string && data.artwork is string;
    }

    function isValidGenre(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.name is string;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['id']) && data.id is string;
    }

    // Beats catalog: Anyone can view and edit (Auth-less mode)
    match /beats/{beatId} {
      allow read: if true;
      allow create, update: if isValidId(beatId) && isValidBeat(incoming());
      allow delete: if true;
    }

    // Genres collection: Anyone can view and edit (Auth-less mode)
    match /genres/{genreId} {
      allow read: if true;
      allow create, update: if isValidId(genreId) && isValidGenre(incoming());
      allow delete: if true;
    }

    // Settings collection: Anyone can view and update
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidSetting(incoming());
      allow delete: if true;
    }
  }
}
