{
  "entities": {
    "beat": {
      "title": "Beat",
      "description": "An instrumental beat in the catalog",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the beat"
        },
        "title": {
          "type": "string",
          "description": "Title of the beat"
        },
        "tagline": {
          "type": "string",
          "description": "Brief tagline or description"
        },
        "bpm": {
          "type": "number",
          "description": "Beats per minute"
        },
        "key": {
          "type": "string",
          "description": "Musical key of the beat"
        },
        "genre": {
          "type": "string",
          "description": "Genre classification"
        },
        "tags": {
          "type": "array",
          "description": "Tags/styles as strings"
        },
        "priceBasic": {
          "type": "number",
          "description": "License price for basic"
        },
        "pricePremium": {
          "type": "number",
          "description": "License price for premium"
        },
        "priceUnlimited": {
          "type": "number",
          "description": "License price for unlimited"
        },
        "duration": {
          "type": "string",
          "description": "Duration formatted as MM:SS"
        },
        "artwork": {
          "type": "string",
          "description": "Artwork image URL"
        },
        "mood": {
          "type": "string",
          "description": "Mood of the beat"
        },
        "beatUrl": {
          "type": "string",
          "description": "External audio URL to play"
        },
        "plays": {
          "type": "number",
          "description": "Total number of times this beat has been played"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "title", "bpm", "genre", "artwork"]
    },
    "genre": {
      "title": "Genre",
      "description": "A musical genre tag for classification",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (kebab-case name)"
        },
        "name": {
          "type": "string",
          "description": "Display name of the genre"
        }
      },
      "required": ["id", "name"]
    },
    "setting": {
      "title": "Site Settings",
      "description": "Global application configuration including producer profile and Instagram social links",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document ID, e.g. general"
        },
        "instagramLink": {
          "type": "string",
          "description": "Instagram handle, username, or profile link"
        },
        "instagramHandle": {
          "type": "string",
          "description": "Normalized Instagram username"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "beats": {
      "schema": "beat",
      "description": "Collection of beats added by the administrator"
    },
    "genres": {
      "schema": "genre",
      "description": "Collection of available genres for the catalog"
    },
    "settings": {
      "schema": "setting",
      "description": "Collection storing application settings such as Instagram contact information"
    }
  }
}
